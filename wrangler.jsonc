{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "limiar",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-28",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ]
}
