{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "limiar",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "src",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "limiar-db",
      "database_id": "e40efc13-7586-4c35-87bd-3e1cf4c20aff",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "limiar-files"
    }
  ]
}
